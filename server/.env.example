# Server Port
PORT=3001
NODE_ENV=production

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Secrets (use long random strings in production)
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string

# BSC RPC
BSC_RPC_URL=https://bsc-dataseed.binance.org

# Frontend URL (set to your deployed domain)
CLIENT_URL=http://localhost

# AI Engine URL (use Docker service name in production)
AI_ENGINE_URL=http://ai-engine:8000

# Market Data
BINANCE_BASE_URL=https://api.binance.com
ALPHA_VANTAGE_API_KEY=demo

# Pocket Option
POCKET_OPTION_API_KEY=
POCKET_OPTION_HEADLESS=true
POCKET_OPTION_SIMULATE_ONLY=true
POCKET_OPTION_URL=https://pocketoption.com/en/cabinet/demo-quick-high-low/

# MT5 Bridge
MT5_BRIDGE_URL=

# Admin seed email
ADMIN_EMAIL=admin@example.com
